# Ollama is only ever called from the server. Keep it bound to localhost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DATABASE_URL=postgresql://mangogpt:CHANGE_ME@127.0.0.1:5432/mangogpt?schema=public&connection_limit=10
APP_PORT=3000
# Directory for uploaded documents (Phase 2)
UPLOAD_DIR=./uploads
# Max upload size in MB
MAX_UPLOAD_MB=25

# Login is enforced whenever AUTH_SECRET is set (generate: openssl rand -hex 32).
# Create users with: APP_USER=name APP_PASS='…' APP_ROLE=admin node scripts/create-user.mjs
AUTH_SECRET=
# Sign-up email domain (a subdomain is required, e.g. name@bscse.uiu.ac.bd).
SIGNUP_EMAIL_DOMAIN=uiu.ac.bd

# Admin notifications for new sign-up requests (all optional; fill in either or both).
# Slack: create an Incoming Webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, message it once, then run: node scripts/telegram-chat-id.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public address used for the "Review" link in notifications, e.g. https://your-server:3443
APP_PUBLIC_URL=

# Docker Compose only: password for the bundled PostgreSQL container (also used in DATABASE_URL there).
POSTGRES_PASSWORD=

# Most answers/images one person may have generating at once (fair use of the GPU).
MAX_CONCURRENT_PER_USER=2
# Days to keep the usage/audit log.
LOG_RETENTION_DAYS=90
