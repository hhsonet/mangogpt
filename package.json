{
  "name": "mangogpt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${APP_PORT:-3000}",
    "build": "prisma generate && next build",
    "start": "next start -H ${HOSTNAME:-127.0.0.1} -p ${APP_PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.50.0",
    "mammoth": "^1.13.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
